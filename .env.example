# Example values for local development; replace credentials outside local runs.
POSTGRES_DB=helpdesk
POSTGRES_USER=helpdesk
POSTGRES_PASSWORD=change-me-local-only
POSTGRES_PORT=5432
TEST_DATABASE_URL=postgresql+asyncpg://helpdesk:change-me-local-only@localhost:5432/helpdesk_test
API_PORT=8000
HELPDESK_MOCK_PORT=8001
LOG_LEVEL=INFO
LLM_API_URL=https://api.openai.com/v1/chat/completions
LLM_MODEL=gpt-4o-mini
LLM_API_KEY=
LLM_STATIC_FALLBACK_ENABLED=true
LLM_TIMEOUT_SECONDS=30
# Enough in-flight work to sustain one generation request per second at 30s latency.
WORKER_CONCURRENCY=30
WORKER_POLL_SECONDS=1
WORKER_LEASE_SECONDS=120
WORKER_MAX_ATTEMPTS=5
WORKER_BACKOFF_BASE_SECONDS=5
WORKER_BACKOFF_MAX_SECONDS=300
SENDER_TIMEOUT_SECONDS=10
SENDER_MAX_ATTEMPTS=5
SENDER_LEASE_SECONDS=300
# Add the exact hostnames used by the real helpdesk reply_url when deploying.
HELPDESK_ALLOWED_REPLY_HOSTS=helpdesk-mock
MOCK_FAILURE_RATE=0
MOCK_HANG_RATE=0
MOCK_HANG_SECONDS=15
MOCK_FAIL_BEFORE_RECORD=0
MOCK_DUPLICATE_MODE=false
MOCK_API_URL=http://api:8000/webhooks/helpdesk
